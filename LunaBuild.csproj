<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lunabuild</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tools/LunaBuild/src/LunaBuild.Cli/Program.cs" Link="Program.cs" />
    <Compile Include="Tools/LunaBuild/src/LunaBuild.Cli/LunaBuildCli.cs" Link="LunaBuildCli.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Tools/LunaBuild/src/LunaBuild.Core/LunaBuild.Core.csproj" />
  </ItemGroup>
</Project>
