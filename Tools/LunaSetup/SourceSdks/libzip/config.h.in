/* LunaBuild configuration for the pinned libzip sources. */
#ifndef HAD_CONFIG_H
#define HAD_CONFIG_H
#include "zipconf.h"
#define PACKAGE "libzip"
#define VERSION LIBZIP_VERSION
#define HAVE_STDBOOL_H 1
#define HAVE_SNPRINTF 1
#define HAVE_STRTOLL 1
#define HAVE_STRTOULL 1
#if defined(_WIN32)
#define SIZEOF_OFF_T 4
#define HAVE__CLOSE 1
#define HAVE__DUP 1
#define HAVE__FDOPEN 1
#define HAVE__FILENO 1
#define HAVE__FSEEKI64 1
#define HAVE__FSTAT64 1
#define HAVE__SETMODE 1
#define HAVE__STAT64 1
#define HAVE__STRDUP 1
#define HAVE__STRICMP 1
#define HAVE__UNLINK 1
#define HAVE_LOCALTIME_S 1
#define HAVE_GETSECURITYINFO 1
#else
#define SIZEOF_OFF_T 8
#define HAVE_FILENO 1
#define HAVE_FCHMOD 1
#define HAVE_FSEEKO 1
#define HAVE_FTELLO 1
#define HAVE_LOCALTIME_R 1
#define HAVE_MKSTEMP 1
#define HAVE_STRCASECMP 1
#define HAVE_STRDUP 1
#define HAVE_STRINGS_H 1
#define HAVE_UNISTD_H 1
#endif
#if defined(_WIN64) || defined(__LP64__)
#define SIZEOF_SIZE_T 8
#else
#define SIZEOF_SIZE_T 4
#endif
#endif
